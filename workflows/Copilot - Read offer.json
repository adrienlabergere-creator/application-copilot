      "id": "8e173880-1c30-49fd-b5fb-c90a3933341b",
      "name": "Fetch offer (Jina)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        -112
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.data || '').split(/Other Similar Jobs/i)[0];\n\nconst text = raw\n  .replace(/```[\\s\\S]*?```/g, '')\n  .replace(/`\\{[\\s\\S]*?\\}`/g, '')\n  .replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '')\n  .replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1')\n  .split('\\n')\n  .filter(l => l.length < 800 && !l.includes('function ()'))\n  .join('\\n')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim()\n  .slice(0, 15000);\n\nreturn [{\n  json: {\n    offer_url: $('Offer input').first().json.text.trim(),\n    offer_text: text,\n    chars: text.length\n  }\n}];"
      },
