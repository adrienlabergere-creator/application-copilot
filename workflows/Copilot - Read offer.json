    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1e88937-0cb7-4a71-b90e-e66ad5003c15",
              "name": "offer",
              "type": "object",
              "value": "={{ (() => {\n  const t = String($json.text || '');\n  const s = t.indexOf('{');\n  const e = t.lastIndexOf('}');\n  if (s < 0 || e <= s) return { is_job_offer: false };\n  try { return JSON.parse(t.slice(s, e + 1)); } catch (err) { return { is_job_offer: false }; }\n})() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "13711f89-a532-4285-936f-369b612ee2eb",
      "name": "Parse offer",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1472,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const o = $input.first().json.offer || {};\nconst src = $('Clean text').isExecuted\n  ? $('Clean text').first().json\n  : $('Use pasted text').first().json;\n\nconst str = v => (typeof v === 'string' ? v.trim() : '');\nconst arr = v => (Array.isArray(v) ? v.map(str).filter(Boolean).slice(0, 10) : []);\nconst sectors = ['finance', 'tech', 'consulting', 'other'];\n\nconst offer = {\n  is_job_offer: o.is_job_offer === true,\n  job_title: str(o.job_title),\n  company: str(o.company),\n  location: str(o.location),\n  deadline: /^\\d{4}-\\d{2}-\\d{2}$/.test(str(o.deadline)) ? str(o.deadline) : '',\n  language: str(o.language).toLowerCase().slice(0, 2) || 'en',\n  sector: sectors.includes(str(o.sector).toLowerCase()) ? str(o.sector).toLowerCase() : 'other',\n  responsibilities: arr(o.responsibilities),\n  requirements: arr(o.requirements),\n  keywords: arr(o.keywords),\n  offer_url: str(src.offer_url)\n};\n\noffer.valid = offer.is_job_offer\n  && offer.job_title !== ''\n  && offer.company !== ''\n  && (offer.responsibilities.length + offer.requirements.length) >= 2;\n\noffer.offer_key = offer.offer_url || (offer.company + '|' + offer.job_title).toLowerCase();\n\nreturn [{ json: offer }];"
      },
