    {
      "parameters": {
        "jsCode": "const esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst j = $input.first().json || {};\nconst ex = j.execution || {};\nconst wf = j.workflow || {};\nconst err = ex.error || {};\nconst where = ex.lastNodeExecuted || (err.node && err.node.name) || 'unknown step';\nconst msg = String(err.message || 'unknown error').slice(0, 300);\nconst url = ex.url || '';\nconst text = '<b>Application Copilot hit an error</b>'\n  + '\\nWorkflow: ' + esc(wf.name || 'unknown workflow')\n  + '\\nStep: ' + esc(where)\n  + '\\nProblem: ' + esc(msg)\n  + '\\nExecution: ' + esc(ex.id || '?')\n  + (url ? '\\n' + esc(url) : '')\n  + '\\nSend the offer again in a minute. If it keeps failing, open the execution above for details.';\nreturn [{ json: { text } }];\n"
      },
      "id": "e9ae0ef0-73e8-4c9b-af65-b13b9498d101",
      "name": "Build error alert",
      "type": "n8n-nodes-base.code",
